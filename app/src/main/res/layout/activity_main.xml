<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="DINO COMPANION"
            android:textColor="@color/white"
            android:textSize="28sp"
            android:textStyle="bold" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Your little prehistoric friend"
            android:textColor="@color/white"
            android:textSize="14sp" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_card_rounded"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="20dp">
            <ImageView
                android:layout_width="180dp"
                android:layout_height="180dp"
                android:contentDescription="Dino"
                android:src="@drawable/dino_placeholder" />
            <TextView
                android:id="@+id/txtDinoName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Rex"
                android:textColor="@color/white"
                android:textSize="25sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/txtDinoType"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="T-Rex"
                android:textColor="@color/white" />
            <TextView
                android:id="@+id/txtStage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Stage 3"
                android:textColor="@color/white" />
            <TextView
                android:id="@+id/txtXp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="XP 1450"
                android:textColor="@color/white" />
        </LinearLayout>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Dino Stats"
            android:textColor="@color/white"
            android:textSize="20sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/txtHunger"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="85%"
            android:textColor="@color/white" />
        <ProgressBar
            android:id="@+id/progressHunger"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="12dp"
            android:max="100"
            android:progress="85" />
        <TextView
            android:id="@+id/txtHappiness"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="90%"
            android:textColor="@color/white" />
        <ProgressBar
            android:id="@+id/progressHappiness"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="12dp"
            android:max="100"
            android:progress="90" />
        <TextView
            android:id="@+id/txtClean"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="80%"
            android:textColor="@color/white" />
        <ProgressBar
            android:id="@+id/progressClean"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="12dp"
            android:max="100"
            android:progress="80" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:orientation="horizontal">
            <Button
                android:id="@+id/btnFeed"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:text="Feed" />
            <Button
                android:id="@+id/btnPlay"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="Play" />
            <Button
                android:id="@+id/btnClean"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="Clean" />
        </LinearLayout>
        <Button
            android:id="@+id/btnOverlay"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="12dp"
            android:text="Start Floating Dino"
            android:textStyle="bold" />
    </LinearLayout>
</ScrollView>
