                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:text="Version 1.0 • Built for Android"
                        android:textColor="#AFC8F4"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="A living companion that stays with you."
                        android:textColor="#DCEAFF"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
